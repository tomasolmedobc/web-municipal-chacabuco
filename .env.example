APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base de datos principal de la web municipal
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Optional WordPress source connection used for sync/import commands
WP_CONNECTION=wordpress
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_DATABASE=wordpress
WP_DB_USERNAME=root
WP_DB_PASSWORD=
WP_TABLE_PREFIX=wp_
WP_POST_TYPE=post
WP_POST_STATUSES=publish
WP_MEDIA_SOURCE_UPLOADS_PATH=/wp-content/uploads
WP_MEDIA_TARGET_BASE_URL=/images
WP_MEDIA_TARGET_SUFFIX=_resultado
WP_MEDIA_TARGET_EXTENSION=webp

# Base de datos externa para consulta de expedientes
# Completar estos datos para que funcione /tramites-y-servicios/expedientes
EXPEDIENTES_DB_HOST=127.0.0.1
EXPEDIENTES_DB_PORT=3306
EXPEDIENTES_DB_DATABASE=expedientes
EXPEDIENTES_DB_USERNAME=
EXPEDIENTES_DB_PASSWORD=
EXPEDIENTES_DB_CHARSET=utf8mb4

# Base de datos externa/local para gestion de reclamos
RECLAMOS_DB_HOST=127.0.0.1
RECLAMOS_DB_PORT=3306
RECLAMOS_DB_DATABASE=ht59814_reclamos
RECLAMOS_DB_USERNAME=
RECLAMOS_DB_PASSWORD=
RECLAMOS_DB_CHARSET=utf8
RECLAMOS_DB_COLLATION=utf8_general_ci

# Base de datos externa/local para OMIC
OMIC_DB_HOST=127.0.0.1
OMIC_DB_PORT=3306
OMIC_DB_DATABASE=ht59814_omic
OMIC_DB_USERNAME=
OMIC_DB_PASSWORD=
OMIC_DB_CHARSET=utf8
OMIC_DB_COLLATION=utf8_general_ci

# Base de datos externa para consulta de infracciones / Juzgado de Faltas
# Completar estos datos para que funcione /tramites-y-servicios/infracciones
JUZGADO_DB_HOST=127.0.0.1
JUZGADO_DB_PORT=3306
JUZGADO_DB_DATABASE=juzgado
JUZGADO_DB_USERNAME=
JUZGADO_DB_PASSWORD=
JUZGADO_DB_CHARSET=utf8
JUZGADO_DB_COLLATION=utf8_general_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ACCESO_MUNICIPAL_PASSWORD=
ACCESO_MUNICIPAL_LINK_1_TITULO="Webmail municipal"
ACCESO_MUNICIPAL_LINK_1_URL="#"
ACCESO_MUNICIPAL_LINK_2_TITULO="Recibos de sueldo"
ACCESO_MUNICIPAL_LINK_2_URL="#"
ACCESO_MUNICIPAL_LINK_3_TITULO="Intranet"
ACCESO_MUNICIPAL_LINK_3_URL="#"
ACCESO_MUNICIPAL_LINK_4_TITULO="Mesa de entradas"
ACCESO_MUNICIPAL_LINK_4_URL="#"
ACCESO_MUNICIPAL_LINK_5_TITULO="Sistemas administrativos"
ACCESO_MUNICIPAL_LINK_5_URL="#"
ACCESO_MUNICIPAL_LINK_6_TITULO="Soporte técnico"
ACCESO_MUNICIPAL_LINK_6_URL="#"
