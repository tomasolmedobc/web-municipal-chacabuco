# =============================================================================
# MUNICIPALIDAD DE CHACABUCO — Configuración de entorno
# Copiar este archivo como .env y completar los valores marcados con *** TODO ***
# =============================================================================

APP_NAME="Municipalidad de Chacabuco"
APP_ENV=production
# *** TODO: Generar con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# *** TODO PRODUCCIÓN: Cambiar al dominio real con HTTPS
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# LOGS
# *** TODO PRODUCCIÓN: Cambiar LOG_STACK a "daily" para rotación automática
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# BASE DE DATOS PRINCIPAL
# *** TODO PRODUCCIÓN: Cambiar a MySQL/MariaDB completando los valores de abajo
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# *** TODO PRODUCCIÓN: Nombre de la base de datos
# DB_DATABASE=chacabuconoticias_db
# *** TODO PRODUCCIÓN: Usuario de la base de datos
# DB_USERNAME=root
# *** TODO PRODUCCIÓN: Contraseña de la base de datos
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# WordPress (sincronización de noticias — opcional)
# -----------------------------------------------------------------------------
WP_CONNECTION=wordpress
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_DATABASE=wordpress
WP_DB_USERNAME=root
WP_DB_PASSWORD=
WP_TABLE_PREFIX=wp_
WP_POST_TYPE=post
WP_POST_STATUSES=publish
WP_MEDIA_SOURCE_UPLOADS_PATH=/wp-content/uploads
WP_MEDIA_TARGET_BASE_URL=/images
WP_MEDIA_TARGET_SUFFIX=_resultado
WP_MEDIA_TARGET_EXTENSION=webp

# -----------------------------------------------------------------------------
# Base de datos externa — Expedientes municipales
# Completar para que funcione /tramites-y-servicios/expedientes
# -----------------------------------------------------------------------------
EXPEDIENTES_DB_HOST=127.0.0.1
EXPEDIENTES_DB_PORT=3306
EXPEDIENTES_DB_DATABASE=expedientes
EXPEDIENTES_DB_USERNAME=
EXPEDIENTES_DB_PASSWORD=
EXPEDIENTES_DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# Base de datos externa — Reclamos
# -----------------------------------------------------------------------------
RECLAMOS_DB_HOST=127.0.0.1
RECLAMOS_DB_PORT=3306
RECLAMOS_DB_DATABASE=ht59814_reclamos
RECLAMOS_DB_USERNAME=
RECLAMOS_DB_PASSWORD=
RECLAMOS_DB_CHARSET=utf8
RECLAMOS_DB_COLLATION=utf8_general_ci

# -----------------------------------------------------------------------------
# Base de datos externa — OMIC
# -----------------------------------------------------------------------------
OMIC_DB_HOST=127.0.0.1
OMIC_DB_PORT=3306
OMIC_DB_DATABASE=ht59814_omic
OMIC_DB_USERNAME=
OMIC_DB_PASSWORD=
OMIC_DB_CHARSET=utf8
OMIC_DB_COLLATION=utf8_general_ci

# -----------------------------------------------------------------------------
# Base de datos externa — Juzgado de Faltas (infracciones)
# Completar para que funcione /tramites-y-servicios/infracciones
# -----------------------------------------------------------------------------
JUZGADO_DB_HOST=127.0.0.1
JUZGADO_DB_PORT=3306
JUZGADO_DB_DATABASE=juzgado
JUZGADO_DB_USERNAME=
JUZGADO_DB_PASSWORD=
JUZGADO_DB_CHARSET=utf8
JUZGADO_DB_COLLATION=utf8_general_ci

# -----------------------------------------------------------------------------
# SESIÓN
# *** TODO PRODUCCIÓN: Activar SESSION_SECURE_COOKIE y SESSION_ENCRYPT
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# *** TODO PRODUCCIÓN: Cambiar a true — encripta datos de sesión en la BD
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# *** TODO PRODUCCIÓN: Cambiar a true — cookies solo se envían por HTTPS
SESSION_SECURE_COOKIE=false

# -----------------------------------------------------------------------------
# BROADCAST / FILESYSTEM / QUEUE / CACHE
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# CORREO ELECTRÓNICO
# *** TODO PRODUCCIÓN: Configurar SMTP real — hoy los emails van solo al log
# Opciones: smtp, mailgun, ses, postmark
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
# *** TODO PRODUCCIÓN: Host SMTP real (ej: mail.chacabuco.gob.ar)
MAIL_HOST=127.0.0.1
# *** TODO PRODUCCIÓN: Puerto SMTP (587 para TLS, 465 para SSL, 25 sin cifrado)
MAIL_PORT=2525
# *** TODO PRODUCCIÓN: Usuario SMTP
MAIL_USERNAME=null
# *** TODO PRODUCCIÓN: Contraseña SMTP
MAIL_PASSWORD=null
# *** TODO PRODUCCIÓN: Dirección remitente real
MAIL_FROM_ADDRESS="noreply@chacabuco.gob.ar"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS S3 (no usado — dejar vacío)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# ACCESO MUNICIPAL (portal interno)
# *** TODO PRODUCCIÓN: Definir contraseña segura antes de activar esta sección
# *** CRÍTICO: Si se deja vacío el portal queda inaccesible (falla hash_equals)
# -----------------------------------------------------------------------------
# *** TODO PRODUCCIÓN: Contraseña de acceso al portal interno
ACCESO_MUNICIPAL_PASSWORD=
ACCESO_MUNICIPAL_LINK_1_TITULO="Webmail municipal"
ACCESO_MUNICIPAL_LINK_1_URL="#"
ACCESO_MUNICIPAL_LINK_2_TITULO="Recibos de sueldo"
ACCESO_MUNICIPAL_LINK_2_URL="#"
ACCESO_MUNICIPAL_LINK_3_TITULO="Intranet"
ACCESO_MUNICIPAL_LINK_3_URL="#"
ACCESO_MUNICIPAL_LINK_4_TITULO="Mesa de entradas"
ACCESO_MUNICIPAL_LINK_4_URL="#"
ACCESO_MUNICIPAL_LINK_5_TITULO="Sistemas administrativos"
ACCESO_MUNICIPAL_LINK_5_URL="#"
ACCESO_MUNICIPAL_LINK_6_TITULO="Soporte técnico"
ACCESO_MUNICIPAL_LINK_6_URL="#"

# =============================================================================
# CHECKLIST DE DEPLOY (ejecutar en el servidor en este orden):
# =============================================================================
# 1. cp .env.example .env
# 2. Completar todos los *** TODO PRODUCCIÓN *** del .env
# 3. php artisan key:generate
# 4. php artisan migrate --force
# 5. php artisan storage:link
# 6. php artisan config:cache
# 7. php artisan route:cache
# 8. php artisan view:cache
# 9. php artisan event:cache
# 10. Descomentar el bloque HTTPS en public/.htaccess
# 11. Verificar que SESSION_SECURE_COOKIE=true y SESSION_ENCRYPT=true en .env
# =============================================================================
