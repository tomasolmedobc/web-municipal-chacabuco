# =============================================================================
# MUNICIPALIDAD DE CHACABUCO — Configuración de entorno (PRODUCCIÓN)
# Copiar este archivo como .env en el servidor y completar los valores
# marcados con *** TODO ***
# =============================================================================

APP_NAME="Municipalidad de Chacabuco"
APP_ENV=production
# *** TODO: Generar con: php artisan key:generate
APP_KEY=
APP_DEBUG=false
# *** TODO: Cambiar al dominio real con HTTPS (ej: https://www.chacabuco.gob.ar)
APP_URL=https://

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# BASE DE DATOS PRINCIPAL
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# *** TODO: Nombre de la base de datos
DB_DATABASE=chacabuconoticias_db
# *** TODO: Usuario de la base de datos (no usar root)
DB_USERNAME=
# *** TODO: Contraseña de la base de datos
DB_PASSWORD=

# -----------------------------------------------------------------------------
# WordPress (sincronización de noticias — opcional)
# -----------------------------------------------------------------------------
#WP_CONNECTION=wordpress
#WP_DB_HOST=127.0.0.1
#WP_DB_PORT=3306
#WP_DB_DATABASE=wordpress
#WP_DB_USERNAME=root
#WP_DB_PASSWORD=
#WP_TABLE_PREFIX=wp_
#WP_POST_TYPE=post
#WP_POST_STATUSES=publish
#WP_MEDIA_SOURCE_UPLOADS_PATH=/wp-content/uploads
#WP_MEDIA_TARGET_BASE_URL=/images
#WP_MEDIA_TARGET_SUFFIX=_resultado
#WP_MEDIA_TARGET_EXTENSION=webp

# -----------------------------------------------------------------------------
# Base de datos externa — Expedientes municipales
# Necesaria para /tramites-y-servicios/expedientes
# -----------------------------------------------------------------------------
EXPEDIENTES_DB_HOST=127.0.0.1
EXPEDIENTES_DB_PORT=3306
EXPEDIENTES_DB_DATABASE=ht59814_expedientes
# *** TODO: Usuario / contraseña
EXPEDIENTES_DB_USERNAME=
EXPEDIENTES_DB_PASSWORD=
EXPEDIENTES_DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# Base de datos externa — Reclamos
# -----------------------------------------------------------------------------
RECLAMOS_DB_HOST=127.0.0.1
RECLAMOS_DB_PORT=3306
RECLAMOS_DB_DATABASE=ht59814_reclamos
# *** TODO: Usuario / contraseña
RECLAMOS_DB_USERNAME=
RECLAMOS_DB_PASSWORD=
RECLAMOS_DB_CHARSET=utf8
RECLAMOS_DB_COLLATION=utf8_general_ci

# -----------------------------------------------------------------------------
# Base de datos externa — OMIC
# -----------------------------------------------------------------------------
OMIC_DB_HOST=127.0.0.1
OMIC_DB_PORT=3306
OMIC_DB_DATABASE=ht59814_omic
# *** TODO: Usuario / contraseña
OMIC_DB_USERNAME=
OMIC_DB_PASSWORD=
OMIC_DB_CHARSET=utf8
OMIC_DB_COLLATION=utf8_general_ci

# -----------------------------------------------------------------------------
# Base de datos externa — Juzgado de Faltas (infracciones)
# Necesaria para /tramites-y-servicios/infracciones
# -----------------------------------------------------------------------------
JUZGADO_DB_HOST=127.0.0.1
JUZGADO_DB_PORT=3306
JUZGADO_DB_DATABASE=ht59814_juzgado
# *** TODO: Usuario / contraseña
JUZGADO_DB_USERNAME=
JUZGADO_DB_PASSWORD=
JUZGADO_DB_CHARSET=utf8
JUZGADO_DB_COLLATION=utf8_general_ci

# -----------------------------------------------------------------------------
# SESIÓN (requiere HTTPS)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# -----------------------------------------------------------------------------
# BROADCAST / FILESYSTEM / QUEUE / CACHE
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# CORREO ELECTRÓNICO (SMTP)
# Usado, entre otros, por la recuperación de contraseña
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
# Validar el certificado SSL del servidor SMTP (dejar en true)
MAIL_VERIFY_SSL=true
# *** TODO: Host SMTP real
MAIL_HOST=
MAIL_PORT=587
# *** TODO: Usuario SMTP
MAIL_USERNAME=
# *** TODO: Contraseña SMTP
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@chacabuco.gob.ar"
MAIL_FROM_NAME="Portal Municipal Chacabuco"

# -----------------------------------------------------------------------------
# AWS S3 (no usado — dejar vacío)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# PROXIES DE CONFIANZA
# Dejar VACÍO si el servidor recibe las visitas directo (hosting sin proxy).
# Si hay un proxy delante (Cloudflare, balanceador), completar con las IP/rangos
# del proxy separados por coma. "*" solo si el servidor acepta ÚNICAMENTE tráfico
# del proxy: con el servidor expuesto, permite falsear la IP y saltar los límites.
# Síntoma de que hace falta: todos los visitantes comparten IP (los límites de
# intentos bloquean a todos) o aparecen enlaces http:// en un sitio https.
# -----------------------------------------------------------------------------
TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE (captcha del login)
# *** CRÍTICO: si TURNSTILE_SECRET_KEY queda vacío, el login NO valida captcha
# Claves en: https://dash.cloudflare.com/ → Turnstile
# -----------------------------------------------------------------------------
# *** TODO: Site key real
TURNSTILE_SITE_KEY=
# *** TODO: Secret key real
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# ACCESO MUNICIPAL (portal interno)
# *** CRÍTICO: Si se deja vacío el portal queda inaccesible (falla hash_equals)
# Los enlaces (títulos, URLs, íconos) tienen valores por defecto reales en
# config/acceso_municipal.php. Solo definirlos acá para sobrescribirlos:
#   ACCESO_MUNICIPAL_LINK_1_TITULO=
#   ACCESO_MUNICIPAL_LINK_1_URL=
# -----------------------------------------------------------------------------
# *** TODO: Contraseña segura de acceso al portal interno
ACCESO_MUNICIPAL_PASSWORD=

# =============================================================================
# CHECKLIST DE DEPLOY (ejecutar en el servidor en este orden):
# =============================================================================
# 1. cp .env.example .env
# 2. Completar todos los *** TODO *** del .env
# 3. php artisan key:generate
# 4. php artisan migrate --force
# 5. php artisan storage:link
# 6. php artisan config:cache
# 7. php artisan route:cache
# 8. php artisan view:cache
# 9. php artisan event:cache
# 10. Descomentar el bloque HTTPS en public/.htaccess (líneas 10-11)
# =============================================================================
